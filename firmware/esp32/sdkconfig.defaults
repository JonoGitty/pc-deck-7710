# Defaults that make this build work at all. Each of these has a reason, and
# each of them is a thing someone would otherwise lose an evening to.

# --- the radio ----------------------------------------------------------
# Bluetooth Classic AND BLE. Classic carries A2DP audio from the phone; BLE
# carries firmware updates. Both on one radio is the whole reason this project
# uses the original ESP32 and not an S3, which has no Classic at all.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
# Secure Simple Pairing — "Just Works", because a head unit has no keyboard and
# no display worth typing a passkey into.
#
# There is no option to set. CONFIG_BT_SSP_ENABLED was removed from ESP-IDF;
# it does not exist in v5.3 and setting it produced an "unknown kconfig
# symbol" warning on every build while doing nothing at all. Bluedroid now
# always supports SSP for Classic. The comment stays because the question
# "how does pairing work on a thing with no keypad" is a real one and the
# answer is no longer visible in the config.

# --- memory -------------------------------------------------------------
# WROVER-E, so PSRAM. Album art means decoding a 600x600 JPEG, which does not
# fit in internal RAM next to the Bluetooth and WiFi stacks.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Lets EXT_RAM_BSS_ATTR put the big framebuffers in PSRAM. Without it they sit
# in the 320 KB of internal DRAM alongside the Bluetooth and WiFi stacks, and
# the link fails by about 37 KB — which is the first thing anyone hits here.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- flash --------------------------------------------------------------
# 16 MB, because movies live in their own partition. See partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- rollback -----------------------------------------------------------
# An update that bricks the deck means taking the dash apart. A new image has
# to mark itself good before the bootloader stops treating it as suspect.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- watchdog -----------------------------------------------------------
# A hung render task should reboot into a working deck, not sit there with the
# last frame frozen on the glass looking like it still works.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# --- diagnosing it once it is in a dashboard ----------------------------
# A core dump written to flash is the difference between "it rebooted" and
# knowing which line did it, on a device with no debugger attached.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
